@WeatherBay.Api_HostAddress = https://localhost:7021

### Valid measurement
POST {{WeatherBay.Api_HostAddress}}/api/measurements
Content-Type: application/json

{
  "deviceId": "WB-001",
  "timestamp": "2026-10-26T18:30:00Z",
  "temperatureF": 78.5,
  "humidityPercent": 62.3,
  "windSpeedMph": 8.2,
  "rainfallRateInHr": 0.15,
  "rainfallPH": 6.4
}

### Dry interval with no valid pH reading
POST {{WeatherBay.Api_HostAddress}}/api/measurements
Content-Type: application/json

{
  "deviceId": "WB-001",
  "timestamp": "2026-10-26T18:40:00Z",
  "temperatureF": 78.5,
  "humidityPercent": 62.3,
  "windSpeedMph": 8.2,
  "rainfallRateInHr": 0,
  "rainfallPH": null
}

### Invalid humidity returns HTTP 400
POST {{WeatherBay.Api_HostAddress}}/api/measurements
Content-Type: application/json

{
  "deviceId": "WB-001",
  "timestamp": "2026-10-26T18:40:00Z",
  "temperatureF": 78.5,
  "humidityPercent": 101,
  "windSpeedMph": 8.2,
  "rainfallRateInHr": 0.15,
  "rainfallPH": 6.4
}
