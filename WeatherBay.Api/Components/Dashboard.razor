@page "/dashboard"
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using System.Globalization
@using WeatherBay.Api.Models
@using WeatherBay.Api.Storage
@inject MeasurementStore Store

<PageTitle>Weather Overview | Weather Bay</PageTitle>

<div class="dashboard">
    <aside class="sidebar" aria-label="Dashboard sidebar">
        <a class="brand" href="/dashboard">
            <svg viewBox="0 0 58 42" width="58" height="42" aria-hidden="true">
                <circle cx="11" cy="12" r="11" fill="#f2bb67" />
                <path d="M22 39a15 15 0 1 1 0-30 14 14 0 0 1 26 5 11 11 0 0 1 0 22H31a15 15 0 0 1-9 3Z" fill="#e9fbff" />
            </svg>
            <span>Weather Bay</span>
        </a>
        <p class="sidebar-label">Monitoring</p>
        <nav aria-label="Monitoring">
            <a class="active" href="#overview">Overview</a>
            <a href="#history">History</a>
            <a href="#alerts">Alerts &amp; Settings</a>
        </nav>

        <div class="device-section">
            <p class="sidebar-label">Device</p>
            @if (deviceIds.Count > 0)
            {
                <form class="device-panel" method="get" action="/dashboard">
                    <label for="deviceId">Weather bay</label>
                    <select id="deviceId" name="deviceId">
                        @foreach (var id in deviceIds)
                        {
                            <option value="@id" selected="@(id == selectedDeviceId)">@id</option>
                        }
                    </select>
                    <button type="submit">Show latest</button>
                </form>
            }
            else
            {
                <p class="device-panel">No bays reporting yet</p>
            }
        </div>
    </aside>

    <main class="workspace" id="overview">
        <header class="topbar">
            <div>
                <h1>Weather Overview</h1>
                <p>@(selectedDeviceId is null ? "Localized conditions from your weather bays" : $"Localized conditions from Weather Bay {selectedDeviceId}")</p>
            </div>
            <div class="status-group">
                <span class="badge @(reading is null ? "" : "badge-saved")">@(reading is null ? "Awaiting readings" : "Reading available")</span>
                @if (reading is not null)
                {
                    <span class="badge">
                        Last: <time datetime="@reading.Timestamp.ToString("O", CultureInfo.InvariantCulture)">@reading.Timestamp.ToString("MMM d, h:mm tt 'UTC'", CultureInfo.InvariantCulture)</time>
                    </span>
                }
            </div>
        </header>

        <div class="overview-grid">
            <section class="hero" aria-labelledby="conditions-heading">
                <div>
                    <p class="eyebrow">Field conditions</p>
                    <h2 id="conditions-heading">Current readings</h2>
                    <p>@(reading is null ? "Send a measurement to see current conditions here." : "Latest saved measurements from the selected bay.")</p>
                </div>
                <span class="hero-mark" aria-hidden="true">WB</span>
            </section>

            <dl class="metrics" aria-label="Latest measurements">
                <MetricCard Label="Temperature" Value="@reading?.TemperatureF" Unit="°F" Symbol="°" Tone="temperature" />
                <MetricCard Label="Relative humidity" Value="@reading?.HumidityPercent" Unit="%" Symbol="%" Tone="humidity" />
                <MetricCard Label="Wind speed" Value="@reading?.WindSpeedMph" Unit="mph" Symbol="~" Tone="wind" />
                <MetricCard Label="Rainfall rate" Value="@reading?.RainfallRateInHr" Unit="in/hr" Symbol="R" Tone="rain" />
            </dl>

            <div class="details-grid">
                <HistoryPreview />

                <div class="side-panels">
                    <section class="panel detail-panel" id="alerts" aria-labelledby="alerts-heading">
                        <h2 id="alerts-heading">Alerts &amp; Notifications</h2>
                        <p class="panel-subtitle">Threshold-based email alerts</p>
                        <p class="alert-status">Notification setup pending</p>
                        <button class="manage-button" type="button" disabled>Manage thresholds <span aria-hidden="true">→</span></button>
                    </section>

                    <section class="panel detail-panel" aria-labelledby="experimental-heading">
                        <h2 id="experimental-heading">Experimental Measurement</h2>
                        <p class="panel-subtitle">Rainfall pH · optional test data</p>
                        <div class="experimental-reading">
                            @if (reading?.RainfallPH is double ph)
                            {
                                <strong>@ph.ToString("G", CultureInfo.InvariantCulture)</strong>
                            }
                            else
                            {
                                <span>Unavailable</span>
                            }
                            <span class="badge badge-research">Research / Testing Only</span>
                        </div>
                        <p class="panel-subtitle">Not a required system measurement</p>
                    </section>
                </div>
            </div>
        </div>
    </main>
</div>

@code {
    [SupplyParameterFromQuery(Name = "deviceId")]
    public string? DeviceId { get; set; }

    private IReadOnlyList<string> deviceIds = [];
    private string? selectedDeviceId;
    private MeasurementRequest? reading;

    protected override void OnParametersSet()
    {
        deviceIds = Store.GetDeviceIds();
        selectedDeviceId = DeviceId is not null && deviceIds.Contains(DeviceId)
            ? DeviceId
            : deviceIds.FirstOrDefault();
        reading = selectedDeviceId is null ? null : Store.GetLatest(selectedDeviceId);
    }
}