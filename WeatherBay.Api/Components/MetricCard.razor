@using Microsoft.AspNetCore.Components
@using System.Globalization

<div class="panel metric metric-@Tone">
    <dt><span>@Label</span><span class="metric-symbol" aria-hidden="true">@Symbol</span></dt>
    <dd>
        <span class="metric-value">
            @if (Value is double value)
            {
                @value.ToString("G", CultureInfo.InvariantCulture) <span class="metric-unit">@Unit</span>
            }
            else
            {
                <span class="missing-reading" aria-label="No saved measurement">—</span>
            }
        </span>
        <span class="metric-caption">Latest measurement</span>
    </dd>
</div>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public double? Value { get; set; }
    [Parameter] public string Unit { get; set; } = "";
    [Parameter] public string Symbol { get; set; } = "";
    [Parameter] public string Tone { get; set; } = "";
}
